                {
                    "name": "Get Order Detail",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-API-KEY",
                                "value": "{{api_key}}"
                            },
                            {
                                "key": "X-API-SECRET",
                                "value": "{{api_secret}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/partner/orders/{{last_order_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "partner",
                                "orders",
                                "{{last_order_id}}"
                            ]
                        },
                        "description": "Retrieve a specific order with its full code list. `{{last_order_id}}` is auto-set by the Create Order test script.\n\nCodes are returned decrypted in this response.\n\n**Required permission:** `orders.view`"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Has codes', () => {",
                                    "    const j = pm.response.json();",
                                    "    pm.expect(j.data).to.have.property('codes');",
                                    "    pm.expect(j.data.codes).to.be.an('array');",
                                    "    console.log('Codes in order: ', JSON.stringify(j.data.codes));",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "response": [
                        {
                            "name": "200 OK — Order with codes",
                            "status": "OK",
                            "code": 200,
                            "body": "{\n  \"data\": {\n    \"order_id\": 42,\n    \"status\": \"delivered\",\n    \"payment_status\": \"paid\",\n    \"total\": 10.00,\n    \"created_at\": \"2026-04-09T12:34:56+00:00\",\n    \"items\": [\n      {\n        \"product_id\": 1,\n        \"quantity\": 1,\n        \"price\": 10.00\n      }\n    ],\n    \"codes\": [\n      {\n        \"code\": \"STEAM-XXXX-YYYY-ZZZZ\",\n        \"serial\": \"SN-001\",\n        \"product_id\": 1,\n        \"expiry\": \"2026-12-31\"\n      }\n    ]\n  }\n}"
                        },
                        {
                            "name": "404 — Order not found or not yours",
                            "status": "Not Found",
                            "code": 404,
                            "body": "{\n  \"error\": \"Order not found.\"\n}"
                        }
                    ]
                },
                {
                    "name": "Get Order Detail — Not mine (expect 404)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-API-KEY",
                                "value": "{{api_key}}"
                            },
                            {
                                "key": "X-API-SECRET",
                                "value": "{{api_secret}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/partner/orders/1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
