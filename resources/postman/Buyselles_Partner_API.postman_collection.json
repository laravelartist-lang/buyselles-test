                                "v1",
                                "partner",
                                "orders",
                                "1"
                            ]
                        },
                        "description": "Attempt to access a low-numbered order that likely belongs to another seller — should return 404 (orders are scoped to the key's seller_id)."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Expect 404 — not accessible', () => pm.response.to.have.status(404));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
