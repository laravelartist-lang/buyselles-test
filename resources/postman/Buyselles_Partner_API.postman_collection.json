                    "name": "Rate Limit — Rapid fire (60 req/min limit)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-API-KEY",
                                "value": "{{api_key}}"
                            },
                            {
                                "key": "X-API-SECRET",
                                "value": "{{api_secret}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/partner/balance",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "partner",
                                "balance"
                            ]
                        },
                        "description": "Use Postman Runner with 65+ iterations to trigger the 60 req/min rate limit. Expect 429 responses after the 60th request within a minute."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 429) {",
                                    "    pm.test('Rate limit properly enforced (429)', () => pm.response.to.have.status(429));",
                                    "    console.log('Rate limit hit! Retry-After: ' + pm.response.headers.get('Retry-After') + 's');",
                                    "} else {",
                                    "    pm.test('Under rate limit, got 200', () => pm.response.to.have.status(200));",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "response": [
                        {
                            "name": "429 — Rate limit exceeded",
                            "status": "Too Many Requests",
                            "code": 429,
                            "body": "{\n  \"error\": \"Rate limit exceeded.\",\n  \"retry_after_seconds\": 34\n}"
                        }
                    ]
                }
            ]
        },
