APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:1vaU3dfc+sWjx8TuDXzginRsEa2dp2SBL+Ujs6QCb5c=
APP_DEBUG=true
APP_MODE=live
APP_URL=http://localhost
LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=6valley
DB_USERNAME=root
DB_PASSWORD=
# Set to true ONLY when you intentionally want migrate:fresh / db:wipe on the database above.
ALLOW_DESTRUCTIVE_DB=false
BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Local dev: use "sync" so catalog sync jobs run immediately without Horizon.
# Production/staging with Redis: run `php artisan horizon` or `php artisan queue:work redis --queue=catalog`
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
HORIZON_PATH=horizon
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
NEXMO_KEY=
NEXMO_SECRET=
PURCHASE_CODE=
BUYER_USERNAME=
SOFTWARE_ID=MzE0NDg1OTc=

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

NGINX_PORT=8302
FORCE_HTTPS=true
CONTAINER_NAME_PREFIX=6valley-demo

QZ_TRAY_ENABLED=false
# When enabled, run once: php artisan qz-tray:generate-keys
# qz = guided setup wizard (recommended) | preview = choice modal | auto = silent if printer saved
QZ_TRAY_MODE=qz
QZ_TRAY_DEFAULT_PRINTER=
QZ_TRAY_PAPER_WIDTH=80
QZ_TRAY_CONNECT_TIMEOUT=60
QZ_TRAY_TEST_MODE=false
QZ_TRAY_TEST_PRINTER_NAME="TEST - Validate ESC/POS (no printer)"
QZ_TRAY_TEST_OUTPUT_FILE=buyselles-thermal-test.raw
SECRETORCA_API_KEY=your_secretorca_api_key_here

# ---------------------------------------------------------------------------
# KYC (Sumsub / Idensic)
# ---------------------------------------------------------------------------
# One credential pair serves the web storefront, the customer app and the
# vendor app. Use the Sandbox pair while testing and the Production pair live.
SUMSUB_ENABLED=false
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
# Generated when the webhook is created in the Sumsub dashboard.
SUMSUB_WEBHOOK_SECRET=
# Verification levels configured in the Sumsub dashboard.
SUMSUB_LEVEL_CUSTOMER=customer-kyc
SUMSUB_LEVEL_VENDOR=vendor-kyc
# Lifetime of a generated SDK access token, in seconds.
SUMSUB_ACCESS_TOKEN_TTL=600
SUMSUB_TIMEOUT=15
# Lifetime paid purchase total at which a customer must verify, in base currency.
SUMSUB_CUSTOMER_THRESHOLD=100
# Sumsub posts signed payloads to this path on this host.
SUMSUB_WEBHOOK_PATH=webhooks/sumsub